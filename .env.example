# SQLite 数据库文件路径（目录需存在，默认 ./data/starhub.db）
DATABASE_PATH="./data/starhub.db"

# Auth.js 加密密钥：执行 `npx auth secret` 或 `openssl rand -base64 32` 生成
AUTH_SECRET=""

# GitHub OAuth App：https://github.com/settings/developers -> New OAuth App
# Homepage URL:            http://localhost:3000
# Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 群口令（可选）。设置后新用户需要输入口令才能录入/登记；留空则所有人登录即可用
INVITE_CODE=""

# 管理员 GitHub 用户名（可选，逗号分隔），管理员可以删除任何仓库、无需口令
ADMIN_LOGINS=""

# 失效仓库自动删除宽限期（小时）。仓库在 GitHub 上被删除 / 转私有后先隐藏，
# 持续失效超过该时长且每轮同步都再次确认失效，才连同 Star 记录一起自动删除。默认 72；设为 0 关闭
# REPO_PURGE_GRACE_HOURS=72

# 可选：从一张公开的飞书 Wiki 表格自动录入仓库（表格需有「小红书名」「仓库地址」两列）
# FEISHU_REPO_SHEET_URL="https://xxx.feishu.cn/wiki/xxxxxxxx"

# 部署到线上时填写站点地址，例如 https://star.example.com
# AUTH_URL=""
# AUTH_TRUST_HOST=true

# 服务器访问不了 github.com 时，让本进程的 fetch 走本地代理（仅影响本服务）
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7892
# NO_PROXY=127.0.0.1,localhost
